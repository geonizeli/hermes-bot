pkgname=hermes-bot
pkgver=0.1.0
pkgrel=1
pkgdesc='Chat with Hermes bots on remote Hermes servers'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'xdg-desktop-portal')
makedepends=('rust' 'cargo' 'gcc' 'make')
# GCC LTO turns cxx-qt's C++ bridge objects into bitcode that Rust's linker
# (lld) can't read, leaving every Qt symbol undefined.
options=('!lto')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 target/release/hermes-bot "$pkgdir/usr/bin/hermes-bot"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/hermes-bot.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/hermes-bot.svg"
  install -Dm644 "$startdir/hermes-bot.desktop" "$pkgdir/usr/share/applications/hermes-bot.desktop"
}
