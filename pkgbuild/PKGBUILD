pkgname=hermes-bot
pkgver=0.1.0
pkgrel=1
pkgdesc='Chat with Hermes bots on remote Hermes servers'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('vulkan-icd-loader' 'libxkbcommon' 'libxkbcommon-x11' 'libxcb' 'wayland' 'fontconfig' 'freetype2' 'xdg-desktop-portal')
makedepends=('rust' 'cargo' 'gcc')
# makepkg's LTO flags are for C/C++; cargo does its own optimizing.
options=('!lto')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 target/release/hermes-bot "$pkgdir/usr/bin/hermes-bot"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  for size in 16 22 24 32 48 64 128 256 512; do
    install -Dm644 "$startdir/icons/${size}x${size}/apps/hermes-bot.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/hermes-bot.png"
  done
  install -Dm644 "$startdir/hermes-bot.desktop" "$pkgdir/usr/share/applications/hermes-bot.desktop"
}
